			"EN"
			{
				"1"		"{39ff14}~New~Added ConVar cl_download_retries set max number of attempts to download files from FastDL"
				"2"		"{39ff14}~New~Added ConVars (see details in cvarlist viewmodel and cl_bob)"
				"3"		"{39ff14}~New~Added ConVar r_maxbeamentities for max simultaneous beams to render"
				"4"		"{39ff14}~New~Added ConVar viewmodel_retract to enables weapon view model retraction near obstacles"
				"5"		"{39ff14}~New~Added ConVar engine_no_focus_sleep to set sleep time when the game is not focused"
				"6"		"{39ff14}~New~Added ConVar engine_no_render_minimized to disable update screen rendering when game is minimized (Low CPU and GPU power consumption)"
				"7"		"{39ff14}~New~Added a whitelist of ConVars/Commands from convar_whitelist.cfg config"
				"8"		"{39ff14}~New~Added ConVars to customize more violence and blood effect (see details in cvarlist violence_vfxblood)"
				"9"		"{39ff14}~New~Added map filter in NewGame"
				"10"		"{39ff14}~New~Added favorites server from Steam account"
				"11"		"{39ff14}~New~Added param -noservice to disable game service like TurboNet and others"
				"12"		"{39ff14}~New~Added ConVar snd_mute_losefocus mute sound when game lose focus (enabled by default)"
				"13"		"{39ff14}~New~Added ConVar violence_bloodamount to increase violence"
				"14"		"{39ff14}~New~Added ConVar cl_download_enable_gzip enables support for downloading compressed files from FastDL"
				"15"		"{39ff14}~New~Added ConVar cl_allow_redirect to allow redirection"
				"16"		"{39ff14}~New~Added ConVar hud_draw_only_deathnotices (Useful to moviemaking)"
				"17"		"{39ff14}~New~Added ConVar cl_minviewmodel to enable only standard models in viewmodel"
				"18"		"{39ff14}~New~Added new UI ConVar by connection events to server and spawn"
				"19"		"{f08080}	• ui_window_bringfront_on_event - Bring game to front"
				"20"		"{f08080}	• ui_window_sound_on_event - Play a sound on event"
				"21"		"{39ff14}~New~Added new ConVar for HUD in-game chat (see details in cvarlist hud_saytext)"
				"22"		"{39ff14}~New~Added support for ReHLDS API for listenserver"
				"23"		"{39ff14}~New~Added support CustomFontFiles{} in TrackerScheme.res for a custom font with any language"
				"24"		"{39ff14}~New~Added support to use own font only for chat Fonts { HudChat }"
				"25"		"{39ff14}~New~Added few languages to choose (not a translation)"
				"26"		"{39ff14}~New~Added support for multilayers overview map for extended HUD Radar"
				"27"		"{39ff14}~New~Added halo effect around extended HUD Radar when a bomb is planted"
				"28"		"{39ff14}~New~Added new ConVar hud_saytext_max to set max number of lines in-game chat"
				"29"		"{39ff14}~New~Added cl_gunsmoke quark (Legacy from gunsmoke command)"
				"30"		"{39ff14}~New~Added new ConVar ui_taskbar_iconflash for flash icon on system taskbar to grab the user's attention on events such as connected to game server, or spawn, etc"
				"31"		"{39ff14}~New~Added support submodel hands/arms on depends current team"
				"32"		"{39ff14}~New~Added support hot reload texture of skybox via changed sv_skyname"
				"33"		"{39ff14}~New~Added new dev ConVar r_lockcull, r_lockpvs for purpose performance tests"
				"34"		"{39ff14}~New~Added new command lookatweapon for look at held weapon, if the model supports this animation"
				"35"		"{39ff14}~New~Added new command bindlist for display current keybinds"
				"36"		"{39ff14}~New~Added new command r_cleardecals"
				"37"		"{39ff14}~New~Implemented extended HUD Radar (see details in cvarlist hud_radar)"
				"38"		"{39ff14}~New~Fully reworked HUD DeathNotice and added few ConVar (see details in cvarlist hud_deathnotice)"
				"39"		"{39ff14}~New~Added ConVar hud_message"
				"40"		"{f08080}	• 0 = Disable"
				"41"		"{f08080}	• 1 = Display all messages (Default)"
				"42"		"{f08080}	• 2 = Only HUD messages"
				"43"		"{f08080}	• 3 = Only DHUD messages"
				"44"		"{39ff14}~New~Added advanced settings for sniper rifle."
				"45"		"{39ff14}~New~Reworked precache-system, fixed issue about Texture Overflow MAX_GLTEXTURES."
				"46"		"{ceff00}~Improve~Maximum heap memory size raised to 512MB from 128MB (Default: 256MB)"
				"47"		"{ceff00}~Improve~Beams render limit raised to 4096 from 64 (Set limit by ConVar r_maxbeamentities Default: 128)"
				"48"		"{ceff00}~Improve~Reworked ConVar cl_filterstuffcmd"
				"49"		"{f08080}	• 0 = Disable (No restrictions)"
				"50"		"{f08080}	• 1 = Soft level (few commands can be executed)"
				"51"		"{f08080}	• 2 = Strict level (execution not allowed)"
				"52"		"{ceff00}~Improve~Light maps limit raised to 512 from 64"
				"53"		"{ceff00}~Improve~Decals render limit raised to 8192 from 4096"
				"54"		"{ceff00}~Improve~Display in the Friends tab, Steam/TurboNet friends playing on servers."
				"55"		"{ceff00}~Improve~Implemented cross-game compatibility between CS and CZ games."
				"56"		"{ceff00}~Improve~Reworked ConVar cl_minmodels, now minmodels will be work even are missing in precache models."
				"57"		"{ffcc33}~Fix~Voice of a local player now records in demo recordings"
				"58"		"{ffcc33}~Fix~Fixed stucking buttons after demo playback"
				"59"		"{ffcc33}~Fix~Fixed gunsmoke in sniper rifles"
				"60"		"{ffcc33}~Fix~Fixed incorrect position of bullet decals on sniper rifles during the holding shoot"
				"61"		"{ffcc33}~Fix~Bugfixes and improvements"
				"62"		"{ffcc33}~Fix~Fixed a hang in client function UTIL_GetNextBestWeapon"
				"63"		"{ffcc33}~Fix~Position simulation is disabled when observing players (cl_smoothtime no longer works in eye mode)"
				"64"		"{ffcc33}~Fix~Fixed a bug with a locked mouse in the game after changing level"
				"65"		"{ffcc33}~Fix~Fixed a bug with a jumping cursor when the game is not in focus"
				"66"		"{ffcc33}~Fix~Fixed a bug with ConVar r_fullbright in multiplayer."
				"67"		"{ffcc33}~Fix~Fixed a voice issue when changing the player's viewent (e.g when using a 3rd-person camera)"
				"68"		"{ffcc33}~Fix~Fixed a bug in UserMessage, in some cases it threw out with svc_bad error."
				"69"		"{ffcc33}~Fix~In dev_overview mode, player viewmodel was visible."
				"70"		"{ffcc33}~Fix~Fixed visibility of the local server in LAN tab."
				"71"		"{ffcc33}~Fix~Miscellaneous fixes in engine."
				"72"		"{ffcc33}~Fix~Fixed incorrect effect of sounds when reverb enabled via room_type."
				"73"		"{ffcc33}~Fix~Fixed a critical bug where game is hanged when playing infrequent VOX sentences emitting from NPC players."
				"74"		"{ffcc33}~Fix~Fixed client Deploy animation caused weapon prediction."
				"75"		"{ffcc33}~Fix~Fixed a crash about AllocBlock: full."
				"76"		"{ffcc33}~Fix~Fixed a crash due bad user-messages StatusIcon and DeathMsg."
				"77"		"{ffcc33}~Fix~Fixed a crash of maps where MAX_MAP_LEAFS was greater than limit of 1024, which able led to undefined behavior in client."
				"78"		"{ffcc33}~Fix~Fixed MOTD when path to includes non latin characters."
				"79"		"{ffcc33}~Fix~Fixed incorrect position players/entities in spectator mode map roaming."
				"80"		"{ffcc33}~Fix~Fixed memory leak SPR_GetList."
				"81"		"{ffcc33}~Fix~Fixed memory leak DetailTextures with r_detailtextures 0."
				"82"		"{ffcc33}~Fix~Fixed memory leak VOX sentence system."
				"83"		"{cccccc}~Misc~Removed restriction ConVar r_dynamic.
You can feel free to disable dynamic light in multi-player for performance reasons on AMD/nVidia GPU's."
			}
